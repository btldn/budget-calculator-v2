# Строка подключения к Postgres.
# Локально (docker-compose.dev.yml) — postgres://budget:budget@localhost:5432/budget
# В проде (docker-compose.yml, app -> db в общей сети) — postgres://budget:budget@db:5432/budget
DATABASE_URL=postgres://budget:budget@localhost:5432/budget

# Символ валюты и локаль для форматирования чисел (Intl.NumberFormat)
APP_CURRENCY=€
APP_LOCALE=ru-RU

# Имена двух аккаунтов, из которых scripts/seed.ts создаёт пользователей.
# Входа по паролю нет — в интерфейсе просто переключаешься между ними.
USER1_NAME=Артём
USER2_NAME=Алина
